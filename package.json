{
  "name": "cherrylift",
  "version": "0.3.0",
  "private": true,
  "description": "Push selected content between WordPress sites (e.g. staging to production) via entity manifests, with automatic ID remapping.",
  "license": "GPL-2.0-or-later",
  "author": "Gabriel de Tassigny",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabriel-detassigny/cherrylift.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build",
    "languages",
    "src",
    "vendor",
    "composer.json",
    "cherrylift.php",
    "uninstall.php",
    "readme.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "wp-scripts build src-js/index.js",
    "start": "wp-scripts start src-js/index.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js src-js tests/e2e playwright.config.js",
    "lint:css": "wp-scripts lint-style \"src-js/**/*.scss\" --allow-empty-input",
    "format": "wp-scripts format src-js tests/e2e",
    "wp-env": "wp-env",
    "wp-env:test": "wp-env --config=.wp-env.test.json",
    "wp-env:target": "wp-env --config=.wp-env.target.json",
    "sites:start": "wp-env start && wp-env run cli wp plugin activate cherrylift && wp-env --config=.wp-env.target.json start && wp-env --config=.wp-env.target.json run cli wp plugin activate cherrylift",
    "sites:stop": "wp-env stop && wp-env --config=.wp-env.target.json stop",
    "demo:source": "wp-env run cli sh wp-content/plugins/cherrylift/dev/demo-content.sh",
    "demo:target": "wp-env --config=.wp-env.target.json run cli sh wp-content/plugins/cherrylift/dev/demo-content.sh",
    "test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/cherrylift vendor/bin/phpunit -c phpunit.xml.dist",
    "test:e2e": "wp-scripts test-playwright",
    "test:e2e:debug": "wp-scripts test-playwright --debug",
    "makepot": "npm run build && composer makepot",
    "plugin-zip": "wp-scripts plugin-zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/date": "^5.56.0",
    "@wordpress/e2e-test-utils-playwright": "^3.1.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/env": "^11.16.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/scripts": "^36.0.0",
    "@wordpress/url": "^4.56.0"
  },
  "dependencies": {
    "@wordpress/dataviews": "~10.1.7"
  },
  "overrides": {
    "markdownlint-cli": {
      "smol-toml": "^1.9.0",
      "js-yaml": "^5.4.1"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "cssnano-preset-default": {
      "postcss-selector-parser": "^7.1.6"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "^7.0.5"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "express": {
      "qs": "^6.16.1"
    }
  }
}
